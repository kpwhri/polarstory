{
  "name": "polarstory-vscode",
  "displayName": "polarstory",
  "description": "Profile local parquet files in VS Code",
  "publisher": "dcronkite",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:polarstory.inspect",
    "onCommand:polarstory.profileQuick",
    "onCommand:polarstory.profileStandard",
    "onCommand:polarstory.profileFull",
    "onCommand:polarstory.advanced"
  ],
  "contributes": {
    "commands": [
      {
        "command": "polarstory.inspect",
        "title": "polarstory: Inspect Parquet Metadata"
      },
      {
        "command": "polarstory.profileQuick",
        "title": "polarstory: Generate Quick Profile"
      },
      {
        "command": "polarstory.profileStandard",
        "title": "polarstory: Generate Standard Profile"
      },
      {
        "command": "polarstory.profileFull",
        "title": "polarstory: Generate Full Profile"
      },
      {
        "command": "polarstory.advanced",
        "title": "polarstory: Advanced Diagnostics..."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "polarstory.parquetMenu",
          "when": "resourceExtname == .parquet && resourceScheme == file",
          "group": "navigation@90"
        }
      ],
      "polarstory.parquetMenu": [
        {
          "command": "polarstory.inspect",
          "group": "1_polarstory@1"
        },
        {
          "command": "polarstory.profileQuick",
          "group": "1_polarstory@2"
        },
        {
          "command": "polarstory.profileStandard",
          "group": "1_polarstory@3"
        },
        {
          "command": "polarstory.profileFull",
          "group": "1_polarstory@4"
        },
        {
          "command": "polarstory.advanced",
          "group": "1_polarstory@5"
        }
      ]
    },
    "configuration": {
      "title": "polarstory",
      "properties": {
        "polarstory.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Override the selected Python interpreter with a Python executable containing polarstory"
        },
        "polarstory.configFile": {
          "type": "string",
          "default": "",
          "description": "Optional polarstory.toml path, absolute or relative to the workspace"
        },
        "polarstory.openReport": {
          "type": "boolean",
          "default": true,
          "description": "Open the generated static HTML in the default browser"
        }
      }
    },
    "submenus": [
      {
        "id": "polarstory.parquetMenu",
        "label": "polarstory"
      }
    ]
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check extension.js && node --check helpers.js"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Profiles are generated by executing the workspace-selected Python interpreter"
    }
  }
}
